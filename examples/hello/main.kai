import ffi
import os.env
import time
import encoding.json
import encoding.json_bind
import motu.app
import motu.desktop
import motu.menu
import motu.shim

fn command(c: Call) : Result[JsonValue, String] / Desktop + Stdout + Clock = match c.cmd {
  "greet"  -> Ok(JStr("Hello, #{app.arg_string(c, "name") ?? "you"}, from kaikai"))
  "ping"   -> Ok(JNull)
  "slow"   -> { time.sleep(time.seconds(5)); Ok(JStr("finished")) }
  other    -> Err("unknown command #{other}")
}

fn main() : Int / Spawn + Ffi + Stdout + Env + Clock + File = {
  let page = env.get("MOTU_PAGE") ?? "index.html"
  let cfg = Config {
    name: "Hello", assets: "examples/hello/assets", page: page,
    title: "Motu", width: 640, height: 400, menus: [menu.edit_menu()],
  }
  app.run(cfg, c => command(c), ev => app.default_event(ev))
}
