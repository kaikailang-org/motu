import fs.dir
import fs.file
import motu.project
import spawn

fn scratch() : String / File = {
  let d = "#{dir.temp_dir()}/motu-project-test"
  dir.create_dir(d) |> ignore
  d
}

test "paths resolve under the root" {
  assert project.resolve("/p", "docs/a.md") == Ok("/p/docs/a.md")
  assert project.resolve("/p", "./docs//a.md") == Ok("/p/docs/a.md")
  assert project.resolve("/p", "") == Ok("/p")
}

test "absolute paths and climbing out are refused" {
  assert project.resolve("/p", "/etc/passwd") |> is_err
  assert project.resolve("/p", "../x") |> is_err
  assert project.resolve("/p", "docs/../../x") |> is_err
}

test "a write is atomic and leaves no temporary file" {
  let root = scratch()
  let r = project.with_project(root, () => {
    Project.write("ch1.md", "first") |> ignore
    Project.write("ch1.md", "second") |> ignore
    Project.read("ch1.md")
  })
  assert r == Ok("second")
  assert not (dir.list_dir(root) |> list.any(n => string.ends_with(n, ".motu-tmp")))
}

test "writes of one file at once each succeed and leave one whole text" {
  let d = "#{scratch()}/concurrent"
  dir.create_dir(d) |> ignore
  let full = "#{d}/notes.json"
  let texts = string.chars("abcdefghijklmnop") | (c => string.repeat("#{c};", 4000))
  let results = nursery { n ->
    let fibers = texts | (t => n.spawn(() => project.write_atomic(full, t)))
    fibers | (f => n.await(f))
  }
  assert results |> list.all(r => r == Ok(()))
  assert list.contains(texts, ok(file.read(full)) ?? "")
  assert dir.list_dir(d) == ["notes.json"]
}

test "a command cannot read outside the project" {
  let root = scratch()
  let r = project.with_project(root, () => Project.read("../../etc/hosts"))
  assert r |> is_err
}

fn is_err[a](r: Result[a, String]) : Bool = match r {
  Ok(_)  -> false
  Err(_) -> true
}
