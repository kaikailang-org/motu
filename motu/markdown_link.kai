#[doc("Links, images, footnote references, autolinks and inline comments for the inline scanner.")]

import motu.markdown
import motu.markdown_emph
import motu.markdown_entity
import motu.markdown_inline
import motu.markdown_scan

type Dest = { end: Int, url: String, title: String }

#[doc("A link, image or footnote reference opening with the `[` at `i`.")]
pub(pkg) fn bracket(s: String, n: Int, i: Int, image: Bool) : Option[Hit] = {
  let close = match_bracket(s, n, i + 1, 0)
  let after = byte_at(s, close + 1)
  if close < 0 { None }
  else if not image and byte_at(s, i + 1) == 94 and after != 40 { footnote_ref(s, i + 2, close) }
  else if after != 40 { None }
  else {
    match destination(s, close + 2) {
      None    -> None
      Some(d) -> Some(one(d.end, link_node(image, markdown_inline.parse_inline(cut(s, i + 1, close)), d)))
    }
  }
}

fn link_node(image: Bool, kids: [Inline], d: Dest) : Inline =
  if image { Image(kids, d.url, d.title) } else { Link(kids, d.url, d.title) }

fn footnote_ref(s: String, from: Int, close: Int) : Option[Hit] = {
  let label = cut(s, from, close)
  if label == "" or has_space(label, 0) { None } else { Some(one(close + 1, FootnoteRef(label))) }
}

fn has_space(s: String, i: Int) : Bool = {
  let b = byte_at(s, i)
  if b < 0 { false } else if b == 32 or b == 9 or b == 10 { true } else { has_space(s, i + 1) }
}

fn match_bracket(s: String, n: Int, j: Int, depth: Int) : Int =
  if j >= n { -1 }
  else {
    match string_byte_at_int(s, j) {
      92 -> match_bracket(s, n, j + 2, depth)
      96 -> match_bracket(s, n, markdown_inline.skip_code(s, j), depth)
      91 -> match_bracket(s, n, j + 1, depth + 1)
      93 -> if depth == 0 { j } else { match_bracket(s, n, j + 1, depth - 1) }
      _  -> match_bracket(s, n, j + 1, depth)
    }
  }

fn skip_ws(s: String, i: Int) : Int = {
  let b = byte_at(s, i)
  if b == 32 or b == 9 or b == 10 { skip_ws(s, i + 1) } else { i }
}

fn destination(s: String, i: Int) : Option[Dest] = {
  let j = skip_ws(s, i)
  if byte_at(s, j) == 60 {
    let e = angle_dest_end(s, j + 1)
    if e < 0 { None } else { dest_tail(s, e, cut(s, j + 1, e - 1)) }
  } else {
    let e = bare_dest_end(s, j, 0)
    if e < 0 { None } else { dest_tail(s, e, cut(s, j, e)) }
  }
}

fn dest_tail(s: String, url_end: Int, url: String) : Option[Dest] = {
  let k = skip_ws(s, url_end)
  let t = if k > url_end { title_end(s, k) } else { -1 }
  let after = if t > 0 { skip_ws(s, t) } else { k }
  let title = if t > 0 { cut(s, k + 1, t - 1) } else { "" }
  if byte_at(s, after) != 41 { None }
  else { Some(Dest { end: after + 1, url: unescape(url), title: unescape(title) }) }
}

fn angle_dest_end(s: String, i: Int) : Int = match byte_at(s, i) {
  62 -> i + 1
  92 -> angle_dest_end(s, i + 2)
  b if b < 0 or b == 10 or b == 60 -> -1
  _  -> angle_dest_end(s, i + 1)
}

fn bare_dest_end(s: String, i: Int, depth: Int) : Int = match byte_at(s, i) {
  92 -> bare_dest_end(s, if is_punct_b(byte_at(s, i + 1)) { i + 2 } else { i + 1 }, depth)
  40 -> bare_dest_end(s, i + 1, depth + 1)
  41 -> if depth == 0 { i } else { bare_dest_end(s, i + 1, depth - 1) }
  b if b < 0 -> -1
  b if b <= 32 -> if depth == 0 { i } else { -1 }
  _ -> bare_dest_end(s, i + 1, depth)
}

fn title_end(s: String, k: Int) : Int = match byte_at(s, k) {
  34 -> quoted_end(s, k + 1, 34)
  39 -> quoted_end(s, k + 1, 39)
  40 -> quoted_end(s, k + 1, 41)
  _  -> -1
}

fn quoted_end(s: String, i: Int, close: Int) : Int = {
  let b = byte_at(s, i)
  if b < 0 { -1 }
  else if b == 92 { quoted_end(s, i + 2, close) }
  else if b == close { i + 1 }
  else { quoted_end(s, i + 1, close) }
}

fn unescape(s: String) : String =
  if find_byte(s, 92, 0) < 0 and find_byte(s, 38, 0) < 0 { s }
  else { string_concat_all(reverse(unescape_loop(s, 0, 0, []))) }

fn unescape_loop(s: String, i: Int, start: Int, acc: [String]) : [String] = {
  let b = byte_at(s, i)
  if b < 0 { [cut(s, start, i), ...acc] }
  else if b == 92 and is_punct_b(byte_at(s, i + 1)) {
    unescape_loop(s, i + 2, i + 2, [cut(s, i + 1, i + 2), cut(s, start, i), ...acc])
  }
  else if b == 38 { unescape_ref(s, i, start, acc) }
  else { unescape_loop(s, i + 1, start, acc) }
}

fn unescape_ref(s: String, i: Int, start: Int, acc: [String]) : [String] = match markdown_entity.decode_at(s, i) {
  Some(p) -> unescape_loop(s, p.fst, p.fst, [p.snd, cut(s, start, i), ...acc])
  None    -> unescape_loop(s, i + 1, start, acc)
}

#[doc("An autolink or an inline comment opening with the `<` at `i`; a comment yields no tokens.")]
pub(pkg) fn angle(s: String, i: Int) : Option[Hit] =
  if starts_at(s, i, "<!--") { comment(s, i) } else { autolink(s, i) }

fn comment(s: String, i: Int) : Option[Hit] = {
  let e = find_from(s, "-->", i + 4)
  if e < 0 { None } else { Some(Hit { next: e + 3, toks: [] }) }
}

fn autolink(s: String, i: Int) : Option[Hit] = {
  let e = autolink_end(s, i + 1)
  if e < 0 { None }
  else {
    let uri = cut(s, i + 1, e)
    if is_uri(uri) { Some(one(e + 1, Link([Text(uri)], uri, ""))) }
    else if is_email(uri) { Some(one(e + 1, Link([Text(uri)], "mailto:#{uri}", ""))) }
    else { None }
  }
}

fn starts_at(s: String, i: Int, p: String) : Bool =
  string_length(s) >= i + string_length(p) and string_slice(s, i, string_length(p)) == p

fn autolink_end(s: String, i: Int) : Int = {
  let b = byte_at(s, i)
  if b == 62 { i }
  else if b <= 32 or b == 60 { -1 }
  else { autolink_end(s, i + 1) }
}

fn is_uri(u: String) : Bool = {
  let k = scheme_len(u, 0)
  k >= 2 and k <= 32 and byte_at(u, k) == 58
}

fn scheme_len(u: String, i: Int) : Int = {
  let b = byte_at(u, i)
  if i == 0 and not is_alpha_b(b) { 0 }
  else if is_alnum_b(b) or b == 43 or b == 46 or b == 45 { scheme_len(u, i + 1) }
  else { i }
}

fn is_email(u: String) : Bool = {
  let at = find_byte(u, 64, 0)
  at > 0 and at < string_length(u) - 1 and find_byte(u, 64, at + 1) < 0 and email_ok(u, 0)
}

fn email_ok(u: String, i: Int) : Bool = {
  let b = byte_at(u, i)
  if b < 0 { true }
  else if is_alnum_b(b) or b == 46 or b == 45 or b == 95 or b == 43 or b == 64 { email_ok(u, i + 1) }
  else { false }
}
