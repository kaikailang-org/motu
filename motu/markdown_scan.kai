#[doc("Byte-level scanning helpers shared by the Markdown block and inline parsers.")]

#[doc("The byte at `i`, or -1 outside the string.")]
pub(pkg) fn byte_at(s: String, i: Int) : Int =
  if i >= 0 and i < string_length(s) { string_byte_at_int(s, i) } else { -1 }

#[doc("The bytes of `s` from offset `k` to the end.")]
pub(pkg) fn drop_bytes(s: String, k: Int) : String = {
  let n = string_length(s)
  if k <= 0 { s } else if k >= n { "" } else { string_slice(s, k, n - k) }
}

#[doc("The bytes of `s` from `from` up to, not including, `to`.")]
pub(pkg) fn cut(s: String, from: Int, to: Int) : String =
  if to <= from { "" } else { string_slice(s, from, to - from) }

#[doc("True for a space or a tab.")]
pub(pkg) fn is_sp(b: Int) : Bool = b == 32 or b == 9

#[doc("True for an ASCII digit.")]
pub(pkg) fn is_digit_b(b: Int) : Bool = b >= 48 and b <= 57

#[doc("True for an ASCII letter.")]
pub(pkg) fn is_alpha_b(b: Int) : Bool = (b >= 65 and b <= 90) or (b >= 97 and b <= 122)

#[doc("True for an ASCII letter or digit.")]
pub(pkg) fn is_alnum_b(b: Int) : Bool = is_alpha_b(b) or is_digit_b(b)

#[doc("True for ASCII punctuation, the characters a backslash may escape.")]
pub(pkg) fn is_punct_b(b: Int) : Bool =
  (b >= 33 and b <= 47) or (b >= 58 and b <= 64) or (b >= 91 and b <= 96) or (b >= 123 and b <= 126)

#[doc("How many times byte `b` repeats from offset `i`.")]
pub(pkg) fn run_of(s: String, i: Int, b: Int) : Int = run_loop(s, i, b, string_length(s), 0)

fn run_loop(s: String, i: Int, b: Int, n: Int, k: Int) : Int =
  if i < n and string_byte_at_int(s, i) == b { run_loop(s, i + 1, b, n, k + 1) } else { k }

#[doc("The offset of the first byte from `i` that is not a space or tab.")]
pub(pkg) fn skip_sp(s: String, i: Int) : Int =
  if i < string_length(s) and is_sp(string_byte_at_int(s, i)) { skip_sp(s, i + 1) } else { i }

#[doc("The number of leading spaces of a line.")]
pub(pkg) fn indent_of(s: String) : Int = run_of(s, 0, 32)

#[doc("True when a line holds nothing but spaces and tabs.")]
pub(pkg) fn blank(s: String) : Bool = skip_sp(s, 0) >= string_length(s)

#[doc("True when every byte from `i` on is a space or tab.")]
pub(pkg) fn blank_from(s: String, i: Int) : Bool = skip_sp(s, i) >= string_length(s)

#[doc("The first offset at or after `i` where `needle` starts, or -1.")]
pub(pkg) fn find_from(s: String, needle: String, i: Int) : Int = {
  if i <= 0 {
    match index_of(s, needle) { Some(k) -> k  None -> -1 }
  } else {
    match index_of(drop_bytes(s, i), needle) { Some(k) -> k + i  None -> -1 }
  }
}

#[doc("The first offset at or after `i` holding byte `b`, or -1.")]
pub(pkg) fn find_byte(s: String, b: Int, i: Int) : Int =
  if i >= string_length(s) { -1 }
  else if string_byte_at_int(s, i) == b { i }
  else { find_byte(s, b, i + 1) }

#[doc("Text of `s` with every ASCII letter lower-cased.")]
pub(pkg) fn lower(s: String) : String = to_lower(s)

#[doc("Character class of a code point for delimiter rules: 0 whitespace, 1 punctuation, 2 other.")]
pub(pkg) fn cp_class(cp: Int) : Int =
  if cp < 0 { 0 }
  else if cp < 128 { ascii_class(cp) }
  else if is_unicode_space(cp) { 0 }
  else if is_unicode_punct(cp) { 1 }
  else { 2 }

fn ascii_class(cp: Int) : Int =
  if cp == 32 or cp == 9 or cp == 10 or cp == 13 or cp == 12 or cp == 11 { 0 }
  else if is_punct_b(cp) { 1 }
  else { 2 }

fn is_unicode_space(cp: Int) : Bool =
  cp == 0xA0 or cp == 0x1680 or (cp >= 0x2000 and cp <= 0x200A)
    or cp == 0x202F or cp == 0x205F or cp == 0x3000

fn is_unicode_punct(cp: Int) : Bool =
  latin1_punct(cp) or (cp >= 0x2010 and cp <= 0x2BFF) or (cp >= 0x3001 and cp <= 0x303F)
    or (cp >= 0xFE30 and cp <= 0xFE4F) or fullwidth_punct(cp)

fn latin1_punct(cp: Int) : Bool =
  (cp >= 0xA1 and cp <= 0xBF and cp != 0xAA and cp != 0xB2 and cp != 0xB3 and cp != 0xB5
    and cp != 0xB9 and cp != 0xBA and cp != 0xBC and cp != 0xBD and cp != 0xBE)
    or cp == 0xD7 or cp == 0xF7

fn fullwidth_punct(cp: Int) : Bool =
  (cp >= 0xFF01 and cp <= 0xFF0F) or (cp >= 0xFF1A and cp <= 0xFF20)
    or (cp >= 0xFF3B and cp <= 0xFF40) or (cp >= 0xFF5B and cp <= 0xFF65)

#[doc("The code point that starts at byte `i`, or -1 at the end of the string.")]
pub(pkg) fn cp_at(s: String, i: Int) : Int =
  if i < 0 or i >= string_length(s) { -1 } else { string_cp_at(s, i) }

#[doc("The code point that ends just before byte `i`, or -1 at the start of the string.")]
pub(pkg) fn cp_before(s: String, i: Int) : Int =
  if i <= 0 { -1 } else { string_cp_at(s, lead_byte(s, i - 1, 3)) }

fn lead_byte(s: String, j: Int, left: Int) : Int = {
  let b = string_byte_at_int(s, j)
  if left > 0 and j > 0 and b >= 0x80 and b < 0xC0 { lead_byte(s, j - 1, left - 1) } else { j }
}

#[doc("Expands tabs in a line's leading whitespace to spaces at four-column stops.")]
pub(pkg) fn expand_tabs(line: String) : String =
  if find_byte(line, 9, 0) < 0 { line } else { tabs_loop(line, 0, 0, []) }

fn tabs_loop(line: String, i: Int, col: Int, acc: [String]) : String = {
  let b = byte_at(line, i)
  if b == 9 {
    let w = 4 - col % 4
    tabs_loop(line, i + 1, col + w, [repeat(" ", w), ...acc])
  } else if b == 32 {
    tabs_loop(line, i + 1, col + 1, [" ", ...acc])
  } else {
    string_concat_all(reverse([drop_bytes(line, i), ...acc]))
  }
}

#[doc("Splits text into lines, accepting LF, CRLF and CR endings and dropping a leading byte order mark.")]
pub(pkg) fn split_lines(text: String) : [String] = {
  let u = drop_prefix(text, "\u{FEFF}") ?? text
  let t = if find_byte(u, 13, 0) < 0 { u }
          else { replace(replace(u, "\r\n", "\n"), "\r", "\n") }
  string_split(t, "\n") | expand_tabs
}
