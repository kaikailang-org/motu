#[doc("""
Markdown to a typed syntax tree: CommonMark blocks and inlines plus
footnotes, with HTML limited to comments. A document may open with a
TOML front matter block between `+++` lines; `split_front_matter`
separates it and `front_matter` decodes it.
""")]

import encoding.toml
import motu.markdown_block
import motu.markdown_scan

#[doc("A span of inline content.")]
#[derive(Eq, Show)]
pub type Inline
  = Text(String)
  | Emph([Inline])
  | Strong([Inline])
  | Code(String)
  | Link([Inline], String, String)
  | Image([Inline], String, String)
  | FootnoteRef(String)
  | SoftBreak
  | HardBreak

#[doc("A block of a document; list items are lists of blocks and `tight` lists drop paragraph tags.")]
#[derive(Eq, Show)]
pub type Block
  = Heading(Int, [Inline])
  | Paragraph([Inline])
  | Quote([Block])
  | BulletList(Bool, [[Block]])
  | OrderedList(Int, Bool, [[Block]])
  | CodeBlock(String, String)
  | ThematicBreak
  | Comment(String)
  | FootnoteDef(String, [Block])

#[doc("A parsed Markdown document.")]
#[derive(Eq, Show)]
pub type Doc = { blocks: [Block] }

#[doc("Parses Markdown text into a document; front matter is not stripped.")]
pub fn parse(text: String) : Doc =
  Doc { blocks: markdown_block.parse_blocks(split_lines(text)) }

#[doc("Separates a leading `+++` TOML block from the body; the first part is empty when there is none.")]
pub fn split_front_matter(text: String) : (String, String) = {
  let t = drop_prefix(text, "\u{FEFF}") ?? text
  let first = find_byte(t, 10, 0)
  if first < 0 or not fence_line(cut(t, 0, first)) { ("", text) }
  else { close_front(t, first + 1, first + 1) ?? ("", text) }
}

fn fence_line(line: String) : Bool = trim_right(line) == "+++"

fn close_front(t: String, from: Int, p: Int) : Option[(String, String)] = {
  let e = find_byte(t, 10, p)
  let stop = if e < 0 { string_length(t) } else { e }
  if fence_line(cut(t, p, stop)) {
    Some((cut(t, from, p), if e < 0 { "" } else { drop_bytes(t, e + 1) }))
  } else if e < 0 { None }
  else { close_front(t, from, e + 1) }
}

#[doc("Decodes a document's TOML front matter; an empty table when the document has none.")]
pub fn front_matter(text: String) : Result[toml.TomlValue, String] = {
  let (fm, _) = split_front_matter(text)
  if trim(fm) == "" { Ok(toml.TTbl([])) }
  else {
    match toml.decode_report(fm) {
      Ok(v)  -> Ok(v)
      Err(e) -> Err(toml.error_message(e))
    }
  }
}
